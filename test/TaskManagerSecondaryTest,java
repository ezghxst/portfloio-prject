import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertFalse;
import static org.junit.Assert.assertTrue;
import org.junit.Test;

public class PlayerTrackerSecondaryTest {

    @Test
    public void testToString() {
        PlayerTracker t = new PlayerTracker1L();
        t.addPlayer("LeBron James");
        t.updateStat("LeBron James", "points", 25);

        String result = t.toString();

        assertTrue(result.contains("LeBron James"));
        assertTrue(result.contains("points=25"));
    }

    @Test
    public void testEqualsTrue() {
        PlayerTracker t1 = new PlayerTracker1L();
        PlayerTracker t2 = new PlayerTracker1L();

        t1.addPlayer("Curry");
        t1.updateStat("Curry", "points", 30);

        t2.addPlayer("Curry");
        t2.updateStat("Curry", "points", 30);

        assertTrue(t1.equals(t2));
    }

    @Test
    public void testEqualsFalse() {
        PlayerTracker t1 = new PlayerTracker1L();
        PlayerTracker t2 = new PlayerTracker1L();

        t1.addPlayer("Curry");
        t1.updateStat("Curry", "points", 30);

        t2.addPlayer("Curry");
        t2.updateStat("Curry", "points", 25);

        assertFalse(t1.equals(t2));
    }

    @Test
    public void testHighestPlayer() {
        PlayerTracker t = new PlayerTracker1L();
        t.addPlayer("PlayerA");
        t.addPlayer("PlayerB");
        t.updateStat("PlayerA", "points", 15);
        t.updateStat("PlayerB", "points", 28);

        assertEquals("PlayerB", t.highestPlayer("points"));
    }
}
